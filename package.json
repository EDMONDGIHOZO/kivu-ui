{
  "name": "kivu-ui",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "npm": ">=11.5.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "npm run build -w @kivu-ui/react",
    "dev": "npm run dev -w @kivu-ui/playground",
    "pack:check": "npm pack --dry-run -w @kivu-ui/react --ignore-scripts",
    "test": "npm test -w @kivu-ui/react",
    "typecheck": "npm run typecheck -w @kivu-ui/react"
  }
}
